# Public hostname(s) accepted by the MCP HTTP endpoint.
# Credentials are supplied as Docker secrets under ./secrets/.
PERSONAL_REPO_MCP_ALLOWED_HOSTS=mcp.example.com
PERSONAL_REPO_MCP_ALLOWED_ORIGINS=https://mcp.example.com

# Optional: OAuth + single sign-on (OIDC) for MCP clients such as ChatGPT or Claude.
# Leave OIDC_ISSUER empty to keep today's behaviour (static bearer token only).
# See docs/DEPLOYMENT.md, "OAuth and single sign-on (OIDC)".
PERSONAL_REPO_MCP_PUBLIC_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=
# base64, at least 32 bytes: openssl rand -base64 32
JWT_SECRET=
