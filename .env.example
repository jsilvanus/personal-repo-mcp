# MCP client authentication token.
PERSONAL_REPO_MCP_TOKEN=replace-with-a-long-random-token

# GitHub PAT used by Git for HTTPS clone/fetch/pull/push.
PERSONAL_REPO_MCP_GITHUB_PAT=replace-with-a-github-pat

# Public hostname(s) accepted by the MCP HTTP endpoint.
PERSONAL_REPO_MCP_ALLOWED_HOSTS=mcp.example.com
PERSONAL_REPO_MCP_ALLOWED_ORIGINS=https://mcp.example.com
